{
  "name": "dsh-delete-session",
  "version": "0.2.0",
  "description": "Delete an archived DeepSeek Harness conversation from its sidebar menu, including its transcript on disk and cached projections",
  "license": "MIT",
  "author": "OGHong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OGHong/dsh-delete-session.git"
  },
  "homepage": "https://github.com/OGHong/dsh-delete-session#readme",
  "bugs": {
    "url": "https://github.com/OGHong/dsh-delete-session/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "session"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node selftest.mjs",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
